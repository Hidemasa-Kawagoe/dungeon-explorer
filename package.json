{
  "name": "dungeon",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev:game": "npm run dev -w @dungeon/game",
    "deploy:game": "npm run deploy -w @dungeon/game",
    "test": "npm test --workspaces --if-present",
    "test:shared": "npm test -w @dungeon/shared",
    "test:game": "npm test -w @dungeon/game",
    "dev:editor": "npm run dev -w @dungeon/editor",
    "deploy:editor": "npm run deploy -w @dungeon/editor",
    "test:editor": "npm test -w @dungeon/editor"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.5.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.161.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
