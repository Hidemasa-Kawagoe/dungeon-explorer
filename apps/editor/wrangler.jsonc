{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "dungeon-editor",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-07",
	"observability": { "enabled": true },
	"upload_source_maps": true,

	// No custom domain available: serve on workers.dev, protected by Cloudflare Access
	// (Workers > dungeon-editor > Access tab, "All traffic"). Until ACCESS_AUD is set the Worker
	// answers 403 to everything. Preview URLs stay disabled.
	"workers_dev": true,
	"preview_urls": false,

	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		// Run the Worker for every request (not just /api/*) so the Access JWT is verified
		// before any asset is served, not only at the edge.
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},

	"kv_namespaces": [
		// Public list the game reads; written only by this Worker (via the index Durable Object).
		// DEPLOY: set "id" to the SAME namespace id used by apps/game (docs/deploy.md step 2).
		{ "binding": "DUNGEON_META", "id": "c788ef1d254e49c789c763426de1132c" }
	],
	"r2_buckets": [
		// Draft maps + editor-only index.json. Never bound to the game Worker.
		{ "binding": "DRAFT", "bucket_name": "dungeon-draft" },
		{ "binding": "PUBLISHED", "bucket_name": "dungeon-published" }
	],
	"durable_objects": {
		"bindings": [{ "name": "EDITOR_LOCK", "class_name": "DungeonEditorLock" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DungeonEditorLock"] }],

	"vars": {
		// Zero Trust team domain, e.g. "myteam.cloudflareaccess.com"
		"ACCESS_TEAM_DOMAIN": "rapid-field-4f2e.cloudflareaccess.com",
		// AUD tag of the Access application protecting the editor hostname
		"ACCESS_AUD": "97ecfa50de92543415444e62dfdd74b263d10fb88c4ba29dd5e38be711dc35b0"
	}
	// TODO(deploy): routes -> { "pattern": "editor.example.com", "custom_domain": true }
}
