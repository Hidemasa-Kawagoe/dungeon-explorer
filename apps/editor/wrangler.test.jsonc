{
	"name": "dungeon-editor-test",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-07",
	"assets": { "directory": "./test/assets", "binding": "ASSETS", "run_worker_first": true },
	"kv_namespaces": [{ "binding": "DUNGEON_META" }],
	"r2_buckets": [
		{ "binding": "DRAFT", "bucket_name": "dungeon-draft" },
		{ "binding": "PUBLISHED", "bucket_name": "dungeon-published" }
	],
	"durable_objects": { "bindings": [{ "name": "EDITOR_LOCK", "class_name": "DungeonEditorLock" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DungeonEditorLock"] }],
	"vars": { "ACCESS_TEAM_DOMAIN": "team.example.cloudflareaccess.com", "ACCESS_AUD": "test-aud", "DEV_BYPASS_EMAIL": "dev@example.com" }
}
