{
	"name": "dungeon-game-test",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-07",
	"assets": { "directory": "./test/assets", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
	"kv_namespaces": [{ "binding": "DUNGEON_META" }, { "binding": "PLAYER_SAVE" }],
	"r2_buckets": [{ "binding": "PUBLISHED", "bucket_name": "dungeon-published" }]
}
