{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"module": "es2022",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"isolatedModules": true,
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["./**/*.ts"]
}
