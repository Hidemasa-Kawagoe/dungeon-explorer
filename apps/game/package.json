{
  "name": "@dungeon/game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && wrangler dev --persist-to ../../.wrangler/state",
    "deploy": "npm run build:client && wrangler deploy",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && tsc -p client/tsconfig.json",
    "build:client": "vite build",
    "dev:client": "vite",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@dungeon/shared": "*",
    "three": "^0.187.0",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/three": "^0.187.0"
  }
}
